# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only, never expose to the browser.
# Only needed for admin scripts (e.g. creating teacher accounts locally).
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — server-only, powers the AI chatbot (added in Phase 5).
ANTHROPIC_API_KEY=
